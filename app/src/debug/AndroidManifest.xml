<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY. Adds the transport test harness as a separate launcher icon
  ("BW Transport Test") in debug builds. Merged only into the debug variant;
  never present in release.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".debug.TransportTestActivity"
            android:exported="true"
            android:label="BW Transport Test">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
